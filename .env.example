# PrivateBin MCP Server Configuration

# Required: PrivateBin server URL
# This is the only server the MCP server will use (security feature)
PRIVATEBIN_SERVER_URL=https://privatebin.net

# Optional: Default passcode for additional security
# If set, this passcode will be used when none is explicitly provided
# This value is hidden from the LLM (security feature)
PRIVATEBIN_DEFAULT_PASSCODE=
